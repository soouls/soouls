{
  "version": 2,
  "framework": null,
  "outputDirectory": "dist",
  "buildCommand": "cd ../.. && npx turbo run build --filter=@soouls/backend",
  "installCommand": "cd ../.. && bun install",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}
