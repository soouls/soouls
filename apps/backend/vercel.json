{
  "version": 2,
  "buildCommand": "cd ../.. && npx turbo run build --filter=@soouls/backend",
  "installCommand": "cd ../.. && bun install",
  "functions": {
    "src/main.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/main.ts"
    }
  ]
}
