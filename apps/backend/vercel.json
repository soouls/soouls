{
  "version": 2,
  "framework": null,
  "outputDirectory": "dist",
  "buildCommand": "cd ../.. && npx turbo run build --filter=@soouls/backend",
  "installCommand": "cd ../.. && bun install",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
