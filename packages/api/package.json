{
  "name": "@soouls/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "types": "./src/router.ts",
      "default": "./dist/router.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./trpc": {
      "types": "./src/trpc.ts",
      "default": "./dist/trpc.js"
    },
    "./rate-limit": {
      "types": "./src/rate-limit.ts",
      "default": "./dist/rate-limit.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@soouls/ai-engine": "*",
    "@soouls/database": "*",
    "@soouls/logic": "*",
    "@trpc/client": "^11.9.0",
    "@trpc/server": "^11.0.0-rc.710",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@soouls/typescript-config": "*",
    "typescript": "5.9.2"
  }
}
