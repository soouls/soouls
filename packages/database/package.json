{
  "name": "@soouls/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./waitlist-data": {
      "types": "./src/waitlist-data.ts",
      "default": "./dist/waitlist-data.js"
    },
    "./migrations": "./migrations"
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@soouls/typescript-config": "*",
    "@types/node": "^20.3.1",
    "drizzle-kit": "^0.31.8",
    "typescript": "5.9.2"
  }
}
